<?xml version="1.0"?>
<robot name="puzzlebot">

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Jetson_Lidar_Edition_Base.stl" scale="1 1 1"/>
                <box size="0.2 0.15 0.05"/>
            </geometry>
        </visual>
    </link>

    <link name="wheel_l">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Wheel.stl" scale="1 1 1"/>
            </geometry>
        </visual>
    </link>

    <link name="wheel_r">
        <visual>
            <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Wheel.stl" scale="1 1 1"/>
            </geometry>
        </visual>
    </link>

    <link name="caster">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Caster_Wheel.stl" scale="1 1 1"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <joint name="wheel_l_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_l"/>
        <origin xyz="0.052 0.095 -0.0025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wheel_r_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_r"/>
        <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster"/>
        <origin xyz="-0.095 0 -0.04" rpy="0 0 0"/>
    </joint>

    <gazebo reference="base_link">
        <sensor type="ray" name="laser">
            <pose>0 0 0.1 0 0 0</pose>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.5708</min_angle>
                        <max_angle>1.5708</max_angle>
                    </horizontal>
                    <range>
                        <min>0.02</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </scan>
            </ray>
            <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>base_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>/</namespace>
            </ros>
            <update_rate>100</update_rate>
            <left_joint>wheel_l_joint</left_joint>
            <right_joint>wheel_r_joint</right_joint>
            <wheel_separation>0.19</wheel_separation>
            <wheel_diameter>0.1</wheel_diameter>
            <max_wheel_torque>20.0</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
        </plugin>
    </gazebo>

</robot>